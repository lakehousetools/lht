# Extra files for the source distribution (sdist). The package itself is
# picked up from src/ by setuptools.
include README.md LICENSE CHANGELOG.md CONTRIBUTING.md SECURITY.md llms.txt
recursive-include docs *.md
recursive-include examples *.py *.sql
recursive-include tests *.py *.md *.example.toml

global-exclude *.pyc *.so *.pyd __pycache__ .DS_Store
